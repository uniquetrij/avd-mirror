{
    "name":  "avd-mirror",
    "displayName":  "AVD Mirror",
    "description":  "Mirror the Android emulator screen into a VS Code panel and drive it with real multi-touch.",
    "version":  "0.3.35",
    "publisher":  "local",
    "license":  "MIT",
    "engines":  {
                    "vscode":  "^1.85.0"
                },
    "categories":  [
                       "Other"
                   ],
    "main":  "./extension.js",
    "activationEvents":  [
                             "onView:avdMirror.view",
                             "onView:avdMirror.avds",
                             "onStartupFinished"
                         ],
    "contributes":  {
                        "viewsContainers":  {
                                                "panel":  [
                                                              {
                                                                  "id":  "avdMirror",
                                                                  "title":  "AVD Mirror",
                                                                  "icon":  "media/icon.svg"
                                                              }
                                                          ]
                                            },
                        "commands":  [
                                         {
                                             "command":  "avdMirror.open",
                                             "title":  "Open Panel",
                                             "category":  "AVD Mirror",
                                             "icon":  "$(screen-full)"
                                         },
                                         {
                                             "command":  "avdMirror.openInEditor",
                                             "title":  "Open Full Screen (Editor Tab)",
                                             "category":  "AVD Mirror",
                                             "icon":  "$(screen-full)"
                                         },
                                         {
                                             "command":  "avdMirror.toggleDisplay",
                                             "title":  "Choose Where to Show",
                                             "category":  "AVD Mirror",
                                             "icon":  "$(multiple-windows)"
                                         },
                                         {
                                             "command":  "avdMirror.showInPanel",
                                             "title":  "Show Mirror in Panel",
                                             "category":  "AVD Mirror",
                                             "icon":  "$(layout-panel)"
                                         },
                                         {
                                             "command":  "avdMirror.hideFromPanel",
                                             "title":  "Hide Mirror from Panel",
                                             "category":  "AVD Mirror",
                                             "icon":  "$(layout-panel-off)"
                                         },
                                         {
                                             "command":  "avdMirror.showInEditor",
                                             "title":  "Show Mirror in Editor Tab",
                                             "category":  "AVD Mirror",
                                             "icon":  "$(screen-full)"
                                         },
                                         {
                                             "command":  "avdMirror.hideFromEditor",
                                             "title":  "Hide Mirror from Editor Tab",
                                             "category":  "AVD Mirror",
                                             "icon":  "$(screen-normal)"
                                         },
                                         {
                                             "command":  "avdMirror.showInBrowser",
                                             "title":  "Show Mirror in Browser",
                                             "category":  "AVD Mirror",
                                             "icon":  "$(globe)"
                                         },
                                         {
                                             "command":  "avdMirror.hideFromBrowser",
                                             "title":  "Hide Mirror from Browser",
                                             "category":  "AVD Mirror",
                                             "icon":  "$(circle-slash)"
                                         },
                                         {
                                             "command":  "avdMirror.showInEmbedded",
                                             "title":  "Show Mirror in Embedded Browser",
                                             "category":  "AVD Mirror",
                                             "icon":  "$(browser)"
                                         },
                                         {
                                             "command":  "avdMirror.hideFromEmbedded",
                                             "title":  "Hide Mirror from Embedded Browser",
                                             "category":  "AVD Mirror",
                                             "icon":  "$(preview)"
                                         },
                                         {
                                             "command":  "avdMirror.start",
                                             "title":  "Start Server",
                                             "category":  "AVD Mirror"
                                         },
                                         {
                                             "command":  "avdMirror.stop",
                                             "title":  "Stop Server",
                                             "category":  "AVD Mirror"
                                         },
                                         {
                                             "command":  "avdMirror.restart",
                                             "title":  "Restart Server",
                                             "category":  "AVD Mirror"
                                         },
                                         {
                                             "command":  "avdMirror.reload",
                                             "title":  "Reload Panel",
                                             "category":  "AVD Mirror"
                                         },
                                         {
                                             "command":  "avdMirror.toggleHide",
                                             "title":  "Hide / Show Emulator Window",
                                             "category":  "AVD Mirror"
                                         },
                                         {
                                             "command":  "avdMirror.startAvd",
                                             "title":  "Start AVD",
                                             "category":  "AVD Mirror",
                                             "icon":  "$(play)"
                                         },
                                         {
                                             "command":  "avdMirror.stopAvd",
                                             "title":  "Stop AVD",
                                             "category":  "AVD Mirror",
                                             "icon":  "$(debug-stop)"
                                         },
                                         {
                                             "command":  "avdMirror.forceStopAvd",
                                             "title":  "Force Stop AVD",
                                             "category":  "AVD Mirror"
                                         },
                                         {
                                             "command":  "avdMirror.refreshAvds",
                                             "title":  "Refresh AVDs",
                                             "category":  "AVD Mirror",
                                             "icon":  "$(refresh)"
                                         },
                                         {
                                             "command":  "avdMirror.selectAvd",
                                             "title":  "Select AVD",
                                             "category":  "AVD Mirror"
                                         }
                                     ],
                        "views":  {
                                      "avdMirror":  [
                                                        {
                                                            "id":  "avdMirror.view",
                                                            "name":  "Screen",
                                                            "type":  "webview"
                                                        },
                                                        {
                                                            "id":  "avdMirror.avds",
                                                            "name":  "AVDs"
                                                        }
                                                    ]
                                  },
                        "menus":  {
                                      "view/title":  [
                                                        {
                                                            "command":  "avdMirror.openInEditor",
                                                            "when":  "view == avdMirror.view",
                                                            "group":  "navigation@1"
                                                        },
                                                        {
                                                            "command":  "avdMirror.refreshAvds",
                                                            "when":  "view == avdMirror.avds",
                                                            "group":  "navigation@1"
                                                        }
                                                     ],
                                      "commandPalette":  [
                                                             {
                                                                 "command":  "avdMirror.hideFromPanel",
                                                                 "when":  "false"
                                                             },
                                                             {
                                                                 "command":  "avdMirror.hideFromEditor",
                                                                 "when":  "false"
                                                             },
                                                             {
                                                                 "command":  "avdMirror.hideFromBrowser",
                                                                 "when":  "false"
                                                             },
                                                             {
                                                                 "command":  "avdMirror.hideFromEmbedded",
                                                                 "when":  "false"
                                                             }
                                                         ],
                                      "view/item/context":  [
                                                                {
                                                                    "command":  "avdMirror.showInPanel",
                                                                    "when":  "view == avdMirror.avds \u0026\u0026 (viewItem == avdRunningMirrored || viewItem == avdIdleMirrored) \u0026\u0026 !avdMirror.shown.panel",
                                                                    "group":  "2_display@1"
                                                                },
                                                                {
                                                                    "command":  "avdMirror.hideFromPanel",
                                                                    "when":  "view == avdMirror.avds \u0026\u0026 (viewItem == avdRunningMirrored || viewItem == avdIdleMirrored) \u0026\u0026 avdMirror.shown.panel",
                                                                    "group":  "2_display@1"
                                                                },
                                                                {
                                                                    "command":  "avdMirror.showInEditor",
                                                                    "when":  "view == avdMirror.avds \u0026\u0026 (viewItem == avdRunningMirrored || viewItem == avdIdleMirrored) \u0026\u0026 !avdMirror.shown.editor",
                                                                    "group":  "2_display@2"
                                                                },
                                                                {
                                                                    "command":  "avdMirror.hideFromEditor",
                                                                    "when":  "view == avdMirror.avds \u0026\u0026 (viewItem == avdRunningMirrored || viewItem == avdIdleMirrored) \u0026\u0026 avdMirror.shown.editor",
                                                                    "group":  "2_display@2"
                                                                },
                                                                {
                                                                    "command":  "avdMirror.showInBrowser",
                                                                    "when":  "view == avdMirror.avds \u0026\u0026 (viewItem == avdRunningMirrored || viewItem == avdIdleMirrored) \u0026\u0026 !avdMirror.shown.browser",
                                                                    "group":  "2_display@3"
                                                                },
                                                                {
                                                                    "command":  "avdMirror.hideFromBrowser",
                                                                    "when":  "view == avdMirror.avds \u0026\u0026 (viewItem == avdRunningMirrored || viewItem == avdIdleMirrored) \u0026\u0026 avdMirror.shown.browser",
                                                                    "group":  "2_display@3"
                                                                },
                                                                {
                                                                    "command":  "avdMirror.showInEmbedded",
                                                                    "when":  "view == avdMirror.avds \u0026\u0026 (viewItem == avdRunningMirrored || viewItem == avdIdleMirrored) \u0026\u0026 !avdMirror.shown.embedded",
                                                                    "group":  "2_display@4"
                                                                },
                                                                {
                                                                    "command":  "avdMirror.hideFromEmbedded",
                                                                    "when":  "view == avdMirror.avds \u0026\u0026 (viewItem == avdRunningMirrored || viewItem == avdIdleMirrored) \u0026\u0026 avdMirror.shown.embedded",
                                                                    "group":  "2_display@4"
                                                                },
                                                                {
                                                                    "command":  "avdMirror.selectAvd",
                                                                    "when":  "view == avdMirror.avds",
                                                                    "group":  "1_select"
                                                                },
                                                                {
                                                                    "command":  "avdMirror.startAvd",
                                                                    "when":  "view == avdMirror.avds \u0026\u0026 (viewItem == avdIdle || viewItem == avdIdleMirrored)",
                                                                    "group":  "inline@1"
                                                                },
                                                                {
                                                                    "command":  "avdMirror.stopAvd",
                                                                    "when":  "view == avdMirror.avds \u0026\u0026 (viewItem == avdRunning || viewItem == avdRunningMirrored)",
                                                                    "group":  "inline@1"
                                                                },
                                                                {
                                                                    "command":  "avdMirror.forceStopAvd",
                                                                    "when":  "view == avdMirror.avds \u0026\u0026 (viewItem == avdRunning || viewItem == avdRunningMirrored)",
                                                                    "group":  "3_forcestop"
                                                                }
                                                            ]
                                  }
                    }
}
