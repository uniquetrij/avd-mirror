{
  "name": "avd-mirror",
  "displayName": "AVD Mirror",
  "description": "Mirror the Android emulator screen into a VS Code panel and drive it with real multi-touch.",
  "version": "0.3.47",
  "publisher": "uniquetrij",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1E2228",
    "theme": "dark"
  },
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/uniquetrij/avd-mirror.git"
  },
  "homepage": "https://github.com/uniquetrij/avd-mirror#readme",
  "bugs": {
    "url": "https://github.com/uniquetrij/avd-mirror/issues"
  },
  "keywords": [
    "android",
    "emulator",
    "avd",
    "mirror",
    "scrcpy",
    "screen",
    "mirroring",
    "touch",
    "adb",
    "android-studio",
    "device",
    "mobile",
    "testing",
    "remote"
  ],
  "categories": [
    "Testing",
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onView:avdMirror.view",
    "onView:avdMirror.avds",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "avdMirror",
          "title": "AVD Mirror",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "avdMirror.open",
        "title": "Open Panel",
        "category": "AVD Mirror",
        "icon": "$(screen-full)"
      },
      {
        "command": "avdMirror.openInEditor",
        "title": "Open Full Screen (Editor Tab)",
        "category": "AVD Mirror",
        "icon": "$(screen-full)"
      },
      {
        "command": "avdMirror.toggleDisplay",
        "title": "Choose Where to Show",
        "category": "AVD Mirror",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "avdMirror.start",
        "title": "Start Server",
        "category": "AVD Mirror"
      },
      {
        "command": "avdMirror.stop",
        "title": "Stop Server",
        "category": "AVD Mirror"
      },
      {
        "command": "avdMirror.restart",
        "title": "Restart Server",
        "category": "AVD Mirror"
      },
      {
        "command": "avdMirror.reload",
        "title": "Reload Panel",
        "category": "AVD Mirror"
      },
      {
        "command": "avdMirror.toggleHide",
        "title": "Hide / Show Emulator Window",
        "category": "AVD Mirror"
      },
      {
        "command": "avdMirror.hideEmulatorWindow",
        "title": "Hide Emulator Window",
        "category": "AVD Mirror",
        "icon": "$(empty-window)"
      },
      {
        "command": "avdMirror.showEmulatorWindow",
        "title": "Show Emulator Window",
        "category": "AVD Mirror",
        "icon": "$(window)"
      },
      {
        "command": "avdMirror.extendedControls",
        "title": "Extended Controls",
        "category": "AVD Mirror",
        "icon": "$(settings-gear)"
      },
      {
        "command": "avdMirror.startAvd",
        "title": "Start AVD",
        "category": "AVD Mirror",
        "icon": "$(play)"
      },
      {
        "command": "avdMirror.stopAvd",
        "title": "Stop AVD",
        "category": "AVD Mirror",
        "icon": "$(debug-stop)"
      },
      {
        "command": "avdMirror.forceStopAvd",
        "title": "Force Stop AVD",
        "category": "AVD Mirror"
      },
      {
        "command": "avdMirror.refreshAvds",
        "title": "Refresh AVDs",
        "category": "AVD Mirror",
        "icon": "$(refresh)"
      },
      {
        "command": "avdMirror.selectAvd",
        "title": "Select AVD",
        "category": "AVD Mirror"
      },
      {
        "command": "avdMirror.chooseFlagSecure",
        "title": "Honour FLAG_SECURE",
        "category": "AVD Mirror",
        "icon": "$(lock)"
      }
    ],
    "views": {
      "avdMirror": [
        {
          "id": "avdMirror.view",
          "name": "Screen",
          "type": "webview"
        },
        {
          "id": "avdMirror.avds",
          "name": "AVDs"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "avdMirror.openInEditor",
          "when": "view == avdMirror.view",
          "group": "navigation@1"
        },
        {
          "command": "avdMirror.refreshAvds",
          "when": "view == avdMirror.avds",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "avdMirror.hideEmulatorWindow",
          "when": "false"
        },
        {
          "command": "avdMirror.showEmulatorWindow",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "avdMirror.toggleDisplay",
          "when": "view == avdMirror.avds && (viewItem == avdRunningMirrored || viewItem == avdIdleMirrored)",
          "group": "2_display@1"
        },
        {
          "command": "avdMirror.hideEmulatorWindow",
          "when": "view == avdMirror.avds && (viewItem == avdRunning || viewItem == avdRunningMirrored) && !avdMirror.emulatorHidden",
          "group": "inline@1"
        },
        {
          "command": "avdMirror.showEmulatorWindow",
          "when": "view == avdMirror.avds && (viewItem == avdRunning || viewItem == avdRunningMirrored) && avdMirror.emulatorHidden",
          "group": "inline@1"
        },
        {
          "command": "avdMirror.selectAvd",
          "when": "view == avdMirror.avds",
          "group": "1_select"
        },
        {
          "command": "avdMirror.startAvd",
          "when": "view == avdMirror.avds && (viewItem == avdIdle || viewItem == avdIdleMirrored)",
          "group": "inline@2"
        },
        {
          "command": "avdMirror.extendedControls",
          "when": "view == avdMirror.avds && (viewItem == avdRunning || viewItem == avdRunningMirrored)",
          "group": "inline@2"
        },
        {
          "command": "avdMirror.stopAvd",
          "when": "view == avdMirror.avds && (viewItem == avdRunning || viewItem == avdRunningMirrored)",
          "group": "inline@3"
        },
        {
          "command": "avdMirror.forceStopAvd",
          "when": "view == avdMirror.avds && (viewItem == avdRunning || viewItem == avdRunningMirrored)",
          "group": "3_forcestop"
        }
      ]
    },
    "configuration": {
      "title": "AVD Mirror",
      "properties": {
        "avdMirror.honourFlagSecure": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "Behave the way a screenshot would: while the window in front of the guest sets `FLAG_SECURE`, stop showing it and blank the mirror instead.\n\nOff by default - the capture is host-side, so secure windows are mirrored like any other. Run **AVD Mirror: Honour FLAG_SECURE** to switch it."
        }
      }
    }
  }
}
